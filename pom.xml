<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.mailsystem</groupId>
    <artifactId>mail-system-parent</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <!--
        PARENT POM: quản lý version chung cho toàn bộ 3 module.
        Không chứa code, chỉ dùng để build đồng bộ + khai báo dependency dùng chung.
    -->

    <modules>
        <module>mail-common</module>
        <module>mail-server</module>
        <module>mail-client</module>
    </modules>

    <properties>
        <!-- release (thay vì source/target) bảo đảm chỉ dùng API có trong Java 17,
             kể cả khi máy build cài JDK mới hơn. -->
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <gson.version>2.10.1</gson.version>
        <mysql.version>8.3.0</mysql.version>
        <javafx.version>21.0.2</javafx.version>
        <junit.version>5.10.2</junit.version>
    </properties>

    <!-- Dùng cho test ở mọi module (kiểm thử framing, phiên, upload, kết nối TCP thật). -->
    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
        </plugins>
    </build>

</project>
