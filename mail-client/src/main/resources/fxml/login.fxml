<?xml version="1.0" encoding="UTF-8"?>
<!-- Màn hình đăng nhập. Các thẻ import khai báo lớp JavaFX / lớp tự viết được dùng bên dưới. -->
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<?import com.mailsystem.client.ui.PasswordField2?>

<!-- Gốc: StackPane nền gradient; fx:controller chỉ định lớp xử lý sự kiện (LoginController). -->
<StackPane fx:id="root" styleClass="auth-screen" xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.mailsystem.client.controller.LoginController">
    <!-- Khung cuộn (khi cửa sổ thấp), giãn theo cửa sổ, không cuộn ngang. -->
    <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER">
        <!-- StackPane căn giữa thẻ đăng nhập, lề 32/24px. -->
        <StackPane>
            <padding><Insets top="32" right="24" bottom="32" left="24" /></padding>
            <!-- Thẻ đăng nhập: cột dọc, rộng 360..420px, cao vừa nội dung (maxHeight = -Infinity nghĩa là bằng chiều cao ưu tiên). -->
            <VBox styleClass="auth-card" spacing="14" maxWidth="420" minWidth="360" maxHeight="-Infinity">
                <!-- Logo (icon phong bì) + tên ứng dụng + khẩu hiệu. -->
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <StackPane styleClass="brand-logo">
                        <FontIcon iconLiteral="mdi2e-email-outline" iconSize="28" styleClass="icon" />
                    </StackPane>
                    <VBox spacing="2">
                        <Label text="Mail System" styleClass="brand-name" />
                        <Label text="Thư nội bộ · nhiều thiết bị · thời gian thực" styleClass="hint" />
                    </VBox>
                </HBox>
                <!-- Khoảng trống 4px. -->
                <Region prefHeight="4" />
                <!-- Tiêu đề và lời dẫn. -->
                <Label text="Đăng nhập" styleClass="title-xl" />
                <Label text="Dùng tài khoản mail nội bộ của bạn để tiếp tục." styleClass="text-muted" wrapText="true" />

                <!-- Nhãn thông báo chuyển từ màn khác (vd phiên hết hạn); ẩn và không chiếm chỗ cho tới khi có nội dung. -->
                <Label fx:id="noticeLabel" styleClass="form-info" wrapText="true" maxWidth="Infinity"
                       visible="false" managed="false" />

                <!-- Ô email: Enter = Đăng nhập (onAction gọi handleLogin). -->
                <VBox spacing="6">
                    <Label text="Email" styleClass="field-label" />
                    <TextField fx:id="emailField" promptText="ten@mail.local" onAction="#handleLogin" />
                </VBox>
                <!-- Ô mật khẩu có nút con mắt (PasswordField2). -->
                <VBox spacing="6">
                    <Label text="Mật khẩu" styleClass="field-label" />
                    <PasswordField2 fx:id="passwordField" promptText="Mật khẩu" />
                </VBox>
                <!-- Ô mã 2 bước: chỉ hiện khi Server trả TOTP_REQUIRED. -->
                <VBox fx:id="totpBox" spacing="6" visible="false" managed="false">
                    <Label text="Mã xác minh 2 bước" styleClass="field-label" />
                    <TextField fx:id="totpField" promptText="6 chữ số" onAction="#handleLogin" styleClass="totp-field" />
                    <Label text="Mở Google Authenticator / Microsoft Authenticator để xem mã (đổi mỗi 30 giây)."
                           styleClass="hint" wrapText="true" />
                </VBox>

                <!-- Nhãn lỗi (ẩn tới khi có lỗi). -->
                <Label fx:id="errorLabel" styleClass="form-error" wrapText="true" maxWidth="Infinity"
                       visible="false" managed="false" />

                <!-- Nút Đăng nhập (defaultButton: Enter bất kỳ đâu cũng bấm) + vòng xoay đè ở mép phải nút. -->
                <StackPane>
                    <Button fx:id="loginButton" text="Đăng nhập" onAction="#handleLogin" defaultButton="true"
                            maxWidth="Infinity" styleClass="primary-button" />
                    <ProgressIndicator fx:id="spinner" maxWidth="22" maxHeight="22" visible="false"
                                       StackPane.alignment="CENTER_RIGHT">
                        <StackPane.margin><Insets right="14" /></StackPane.margin>
                    </ProgressIndicator>
                </StackPane>

                <!-- Liên kết sang màn Tạo tài khoản. -->
                <HBox alignment="CENTER" spacing="4">
                    <Label text="Chưa có tài khoản?" styleClass="text-muted" />
                    <Hyperlink text="Tạo tài khoản" onAction="#handleGoToRegister" />
                </HBox>

                <!-- Vạch ngăn; hàng dưới: huy hiệu "Mã hoá TLS 1.3" và liên kết "Máy chủ: ..." (bấm để sửa). -->
                <Separator />
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <HBox styleClass="secure-badge" alignment="CENTER_LEFT" spacing="6">
                        <FontIcon iconLiteral="mdi2l-lock-outline" iconSize="14" styleClass="icon" />
                        <Label text="Mã hoá TLS 1.3" />
                    </HBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <Hyperlink fx:id="serverToggle" onAction="#handleToggleServer" />
                </HBox>
                <!-- Ô sửa địa chỉ máy chủ (ẩn mặc định). -->
                <VBox fx:id="serverBox" spacing="6" visible="false" managed="false">
                    <Label text="Máy chủ (host:port)" styleClass="field-label" />
                    <TextField fx:id="serverField" promptText="localhost:5000" onAction="#handleLogin" />
                    <Label text="Dùng địa chỉ IP trong mạng LAN để kết nối tới máy chủ trên máy khác, VD 192.168.1.10:5000."
                           styleClass="hint" wrapText="true" />
                </VBox>
            </VBox>
        </StackPane>
    </ScrollPane>
</StackPane>
