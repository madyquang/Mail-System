<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- TODO (TV3): day chi la khung toi thieu, hay thiet ke lai cho dep hon -->
<VBox spacing="10" alignment="CENTER" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mailsystem.client.controller.LoginController">
    <padding><Insets top="40" right="40" bottom="40" left="40"/></padding>

    <Label text="MAIL SYSTEM - DANG NHAP" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
    <TextField fx:id="emailField" promptText="Email"/>
    <PasswordField fx:id="passwordField" promptText="Mat khau"/>
    <Label fx:id="errorLabel" style="-fx-text-fill: red;"/>
    <Button text="Dang nhap" onAction="#handleLogin"/>
    <Hyperlink text="Chua co tai khoan? Dang ky" onAction="#handleGoToRegister"/>
</VBox>
